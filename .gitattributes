# Normalize line endings on commit so cross-platform checkouts stay sane.
# Defaults: LF on the working tree.
* text=auto eol=lf

# Python: enforce LF strictly (no CRLF ever)
*.py text eol=lf
*.pyi text eol=lf

# Web assets: LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Windows-specific: keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (no text conversion, no diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.tar binary
*.whl binary
*.pyc binary
*.so binary
*.dll binary
*.dylib binary
*.sqlite3 binary
*.db binary

# Markdown tables render better with a Markdown linguist
*.md linguist-detectable=true

# Forbid merges with conflict markers in committed files
# (Git will still let you resolve locally; this just makes the marker more visible)
# Note: not actually enforceable via .gitattributes, this is documentation only.

# Diff highlighting hints
*.py diff=python
*.html diff=html
*.css diff=css
*.js diff=javascript
*.json diff=json
